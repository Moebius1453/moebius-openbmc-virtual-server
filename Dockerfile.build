FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN printf '%s\n' \
      'Types: deb' \
      'URIs: http://mirrors.tuna.tsinghua.edu.cn/ubuntu' \
      'Suites: noble noble-updates noble-security' \
      'Components: main universe' \
      'Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg' \
      > /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential chrpath cpio debianutils diffstat file gawk gcc git git-lfs \
      iputils-ping libacl1 locales lz4 patch python3 python3-git python3-jinja2 \
      python3-pexpect python3-pip socat texinfo unzip wget xz-utils zstd \
      ca-certificates bzip2 libssl-dev \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8
USER 1000:1000
WORKDIR /work
CMD ["bash"]
